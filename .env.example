# =============================================================================
# InsightMatrix frontend — copy to `.env` (local) or set in your host (production)
# =============================================================================

# --- Local development (default) ---
# Public website URL — used for supplier callback links shown in admin (no trailing slash).
# Leave empty locally; the app uses the browser origin (http://localhost:3000).
# NEXT_PUBLIC_APP_URL=

# Server-only: Express API origin for Next.js rewrites (not exposed to the browser).
BACKEND_URL=http://127.0.0.1:5000

# Browser API base — proxied through Next when relative.
NEXT_PUBLIC_API_URL=/api/v1

NEXT_PUBLIC_ENABLE_ROUTE_GUARD=false
NEXT_PUBLIC_AUTH_DISABLED=false

# --- Gateway security (must match backend SECURITY_* flags) ---
# Set both to true when reCAPTCHA is integrated in production.
NEXT_PUBLIC_SECURITY_GATEWAY_ENABLED=false
NEXT_PUBLIC_SECURITY_CAPTCHA_ENABLED=false
# Site key — only used when captcha is enabled above (must match backend RECAPTCHA_SITE_KEY).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Production example (same domain: Next + API proxy) ---
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# BACKEND_URL=http://127.0.0.1:5000
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_ENABLE_ROUTE_GUARD=true

# --- Production example (API on separate subdomain) ---
# NEXT_PUBLIC_APP_URL=https://app.your-domain.com
# BACKEND_URL=https://api.your-domain.com
# NEXT_PUBLIC_API_URL=/api/v1

# Callback redirect URLs are built automatically:
#   {NEXT_PUBLIC_APP_URL}/survey/callback/complete?pid=…
#   {NEXT_PUBLIC_APP_URL}/survey/callback/quota-full?pid=…
#   etc.
# Set the same host on the backend as CLIENT_URL (CORS + password reset links).
