# =============================================================================
# InsightMatrix frontend — PRODUCTION (loaded automatically on `next build` / `next start`)
# Same-domain setup: Next.js on :3000 proxies /api/v1 → Express on :5000 via nginx
# =============================================================================

# Public website URL — callback links, admin copy URLs (no trailing slash)
NEXT_PUBLIC_APP_URL=https://insightmatrix.online

# Server-only: internal Express origin for Next.js rewrites (NOT exposed to browser)
BACKEND_URL=http://127.0.0.1:5000

# Browser API base — relative path when nginx proxies /api/v1 to Express on same host
NEXT_PUBLIC_API_URL=/api/v1

# Protect /dashboard and /admin in production
NEXT_PUBLIC_ENABLE_ROUTE_GUARD=true
NEXT_PUBLIC_AUTH_DISABLED=false

# Gateway security — must match backend SECURITY_* (keep off until captcha is fully tested)
NEXT_PUBLIC_SECURITY_GATEWAY_ENABLED=false
NEXT_PUBLIC_SECURITY_CAPTCHA_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdRbf0sAAAAANhwNdOBewg3O1APDu1iYAhT_-Ib
