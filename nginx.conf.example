# InsightMatrix — nginx reverse proxy (same VPS: Next :3000 + Express :5000)
#
# CRITICAL: /_next/static MUST proxy to Next.js — NOT Express.
# If static chunks return 500, you will see ChunkLoadError in the browser.
#
# Install: sudo cp nginx.conf.example /etc/nginx/sites-available/insightmatrix
#          sudo ln -s /etc/nginx/sites-available/insightmatrix /etc/nginx/sites-enabled/
#          sudo nginx -t && sudo systemctl reload nginx

upstream insightmatrix_next {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream insightmatrix_api {
    server 127.0.0.1:5000;
    keepalive 16;
}

server {
    listen 80;
    server_name insightmatrix.online www.insightmatrix.online;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name insightmatrix.online www.insightmatrix.online;

    # ssl_certificate     /etc/letsencrypt/live/insightmatrix.online/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/insightmatrix.online/privkey.pem;

    client_max_body_size 10m;

    # Express API (proxied through same domain — keeps auth cookies same-site)
    location /api/v1/ {
        proxy_pass http://insightmatrix_api/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # Next.js build output — long cache (filenames are content-hashed)
    location /_next/static/ {
        proxy_pass http://insightmatrix_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Next.js image optimizer + other _next assets
    location /_next/ {
        proxy_pass http://insightmatrix_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public files from /public
    location /favicon.ico {
        proxy_pass http://insightmatrix_next;
    }

    # All pages (dashboard, login, survey routing, vendor links)
    location / {
        proxy_pass http://insightmatrix_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
